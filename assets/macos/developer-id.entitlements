<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- What giode signs every Developer ID build with (Go's runtime). -->
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<!-- The hardened runtime blocks the microphone without this. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Engines from the Engines page (LADSPA plugins, ONNX Runtime) are
	     other developers' libraries: library validation would refuse them. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
